# Discord Developer Portal > Bot > Reset Token 으로 발급받은 값
DISCORD_TOKEN=여기에_봇_토큰

# SQLAlchemy 접속 문자열. 기본값은 프로젝트 루트의 SQLite 파일.
DATABASE_URL=sqlite:///maple_boss_bot.db

# CRITICAL / ERROR / WARNING / INFO / DEBUG
LOG_LEVEL=INFO

# (선택) 개발 중 슬래시 커맨드를 즉시 반영할 서버 ID.
# 비워두면 전역 등록이라 반영에 최대 1시간 걸린다.
GUILD_ID=
